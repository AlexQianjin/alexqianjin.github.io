---
const pageTitle = "Alex Qin (Qianjin Qin) | Senior Frontend Engineer";
const pageDescription =
  "Alex Qin's resume: 17 years in software delivery, including 5+ years specializing in enterprise frontend development, React, TypeScript, and frontend architecture.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <nav class="page-actions" aria-label="Page actions">
      <a href="/" aria-label="Return to the home page">← Back to home</a>
      <div class="action-group">
        <a class="language-link" href="/resume" lang="zh-CN">中文简历</a>
        <span class="action-separator" aria-hidden="true">|</span>
        <button type="button" onclick="window.print()">Print / Save PDF</button>
      </div>
    </nav>

    <main>
      <header class="resume-header">
        <div>
          <p class="eyebrow">RESUME · CURRICULUM VITAE</p>
          <h1>Alex Qin <span class="legal-name">(Qianjin Qin)</span></h1>
          <p class="tagline">Senior Frontend Engineer · Full-Stack Engineer · Technical Team Lead</p>
          <p class="summary-meta">Wuhan, China</p>
        </div>
        <address>
          <div class="contact-row">
            <a href="tel:+8615972217310">+86 159 7221 7310</a>
            <span aria-hidden="true">|</span>
            <a href="mailto:qianjin.qin@gmail.com">qianjin.qin@gmail.com</a>
          </div>
          <div class="contact-row">
            <a href="https://github.com/AlexQianjin">github.com/AlexQianjin</a>
            <span aria-hidden="true">|</span>
            <a href="https://www.linkedin.com/in/qinqianjin">linkedin.com/in/qinqianjin</a>
          </div>
        </address>
      </header>

      <section>
        <h2>PROFESSIONAL SUMMARY</h2>
        <p>Senior engineer and team lead with 17 years in software delivery, including 5+ years specializing in enterprise frontend development. Strong in React, TypeScript, frontend architecture, scalable component systems, performance optimization, and modern engineering practices. Experienced in technical solution design, code review, mentoring, and English collaboration across international teams.</p>
      </section>

      <section>
        <h2>CORE SKILLS</h2>
        <div class="skills">
          <p><strong>Frontend</strong><span>React, React Hooks, TypeScript, JavaScript (ES6+), HTML5, CSS3, Tailwind CSS, responsive design, Vite, Webpack</span></p>
          <p><strong>Architecture</strong><span>Frontend architecture, reusable component systems, state management, design patterns, technical solution design</span></p>
          <p><strong>Backend &amp; Data</strong><span>Java, Node.js, Express, NestJS, REST APIs, PostgreSQL, MySQL, MongoDB, SQLite, Python, C#</span></p>
          <p><strong>Quality &amp; Delivery</strong><span>Code review, Jest, Vitest, Playwright, Git, CI/CD, GitHub Actions, Docker, Scrum</span></p>
          <p><strong>Cloud &amp; Platforms</strong><span>Microsoft Azure, AWS, WeChat Mini Programs, WeChat Official Accounts; Linux, macOS, Windows</span></p>
          <p><strong>AI-Assisted Engineering</strong><span>ChatGPT, Codex, Gemini, and Qwen for development, code review, testing, and technical research</span></p>
          <p><strong>Applied AI Skills</strong><span>Custom skill creation, MCP integration, and spec-driven development</span></p>
        </div>
      </section>

      <section>
        <h2>PROFESSIONAL EXPERIENCE</h2>
        <article>
          <div class="role-heading">
            <h3>Baizhen Biotechnology (Wuhan) Co., Ltd.</h3>
            <p>Jun 2022–Jul 2026</p>
          </div>
          <p class="role">Senior Front-End Engineer</p>
          <ul>
            <li>Designed and developed the React and TypeScript frontend for <strong>PEAKS Online</strong>, an enterprise browser-based protein sequencing product backed by Java and PostgreSQL.</li>
            <li>Contributed to frontend architecture, application structure, reusable components, development standards, and key technical solution decisions.</li>
            <li>Improved maintainability and delivery quality through performance optimization, dependency upgrades, code reviews, unit testing, and E2E automation.</li>
            <li>Integrated Java REST APIs, contributed to selected backend work, mentored developers, and used Codex and Gemini to accelerate implementation, debugging, and technical exploration.</li>
          </ul>
        </article>

        <article>
          <div class="role-heading">
            <h3>Wistron Information Technology &amp; Services Co., Ltd.</h3>
            <p>Aug 2015–Jun 2022</p>
          </div>
          <p class="role">Team Lead / Front-End Engineer</p>
          <ul>
            <li>Led project delivery, front-end development, team mentoring, and technical training; worked on-site in California to clarify requirements and coordinate delivery.</li>
            <li><strong>EWT:</strong> Transformed the product backlog into user stories across seven sprints and enabled one production release in every sprint.</li>
            <li><strong>CEP:</strong> Quickly filled a React development gap, earned code-review privileges, mentored new front-end contributors, and delivered department-wide React training.</li>
          </ul>
        </article>

        <article>
          <div class="role-heading">
            <h3>Wuhan KOTEI Informatics Co., Ltd.</h3>
            <p>Jul 2009–Jul 2015</p>
          </div>
          <p class="role">Project Manager / C# Developer</p>
          <ul>
            <li>Managed requirements, architecture, development, deployment, and on-site delivery for government information systems while leading the team’s customer response.</li>
            <li>Introduced Prism MVVM, AutoMapper, and T4 code generation to improve collaboration and reduce repetitive development.</li>
          </ul>
        </article>
      </section>

      <section>
        <h2>SELECTED PROJECTS</h2>
        <article class="project">
          <h3>PEAKS Online — Protein Sequencing SaaS</h3>
          <p class="project-tech">React · TypeScript · Java · PostgreSQL</p>
          <p>Delivered core frontend features, architecture improvements, reusable components, performance optimization, and automated testing in close collaboration with the Canadian team.</p>
        </article>
        <article class="project">
          <h3>Hubei Provincial Land Resources Petition System</h3>
          <p class="project-tech">Project Management · Architecture · Data Visualization</p>
          <p>Directed requirements, architecture, deployment, and on-site integration. The solution earned client recognition and was demonstrated at a provincial-level conference.</p>
        </article>
      </section>

      <section>
        <h2>EDUCATION &amp; ADDITIONAL INFORMATION</h2>
        <ul>
          <li>China University of Geosciences (Wuhan) | B.S. in Computer Science and Technology | 2023–2026</li>
          <li>Wuhan Language and Culture Vocational College | Diploma in Computer Software Technology | 2006–2009</li>
          <li>Professional working English; multiple on-site engagements with overseas clients; holder of long-term U.S. and Canadian visas</li>
          <li><strong>Interests:</strong> Tennis, road cycling, and strength training</li>
          <li><strong>Target Roles:</strong> Senior Front-End Engineer / Full-Stack Engineer / Project Manager | <strong>Expected Salary:</strong> RMB 25K–30K/month</li>
        </ul>
      </section>
    </main>
  </body>
</html>

<style>
  :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #172033; background: #eef3f6; }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 32px 20px 64px; background: linear-gradient(135deg, #e8f1f5 0%, #f7f4ed 100%); }
  .page-actions { width: min(920px, 100%); margin: 0 auto 16px; display: flex; align-items: center; justify-content: space-between; }
  .action-group { display: flex; align-items: center; gap: 10px; }
  .page-actions a, .page-actions button { color: #174f78; font: inherit; font-size: .88rem; font-weight: 650; text-decoration: none; }
  .page-actions button { border: 1px solid #bdd0dc; border-radius: 999px; padding: 8px 14px; background: rgba(255,255,255,.72); cursor: pointer; }
  .action-separator { color: #8ca4b2; }
  .page-actions a:hover, .page-actions button:hover { color: #0b3655; }
  main { width: min(920px, 100%); margin: 0 auto; padding: 54px 64px 58px; background: #fff; border-top: 6px solid #21648d; border-radius: 4px; box-shadow: 0 18px 55px rgba(30, 59, 78, .13); }
  .resume-header { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: end; padding-bottom: 26px; border-bottom: 1px solid #d9e3e9; }
  .eyebrow { margin: 0 0 10px; color: #39799e; font-size: .69rem; font-weight: 800; letter-spacing: .2em; }
  h1 { margin: 0; color: #102a43; font-size: clamp(2.5rem, 7vw, 4.5rem); font-weight: 780; line-height: .95; letter-spacing: .04em; }
  .legal-name { font-size: .38em; font-weight: 650; letter-spacing: 0; white-space: nowrap; }
  .tagline { margin: 16px 0 4px; color: #174f78; font-size: 1rem; font-weight: 700; }
  .summary-meta { margin: 0; color: #637381; font-size: .9rem; }
  .summary-meta span { margin: 0 .35em; color: #9babb5; }
  address { display: grid; gap: 5px; font-size: .82rem; font-style: normal; text-align: right; }
  .contact-row { display: flex; justify-content: flex-end; gap: .55em; white-space: nowrap; }
  address a { color: #415c6c; text-decoration: none; }
  address a:hover { color: #174f78; text-decoration: underline; }
  section { margin-top: 29px; }
  h2 { display: flex; align-items: center; gap: 14px; margin: 0 0 13px; color: #174f78; font-size: .83rem; line-height: 1.2; letter-spacing: .15em; }
  h2::after { content: ""; height: 1px; flex: 1; background: #d9e3e9; }
  h3 { margin: 0; color: #182f3e; font-size: 1rem; line-height: 1.4; }
  p, li { font-size: .88rem; line-height: 1.68; }
  section > p { margin: 0; }
  strong { color: #153e59; }
  ul { margin: 7px 0 0; padding-left: 1.25rem; }
  li { padding-left: .18rem; }
  li + li { margin-top: 3px; }
  li::marker { color: #4e89ab; }
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 22px; }
  .skills p { display: grid; grid-template-columns: 118px 1fr; gap: 9px; margin: 0; }
  .skills strong { font-size: .8rem; }
  article + article { margin-top: 18px; }
  .role-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .role-heading p { margin: 0; color: #647b89; font-size: .78rem; white-space: nowrap; }
  .role { margin: 1px 0 3px; color: #39799e; font-size: .8rem; font-weight: 700; }
  .project { display: grid; grid-template-columns: 1fr auto; column-gap: 18px; }
  .project-tech { margin: 0; color: #39799e; font-size: .78rem; font-weight: 700; }
  .project > p:last-child { grid-column: 1 / -1; margin: 3px 0 0; }

  @media (max-width: 720px) {
    body { padding: 18px 12px 40px; }
    main { padding: 34px 24px 40px; }
    .resume-header { grid-template-columns: 1fr; gap: 18px; align-items: start; }
    address { text-align: left; }
    .contact-row { justify-content: flex-start; flex-wrap: wrap; white-space: normal; }
    .skills { grid-template-columns: 1fr; }
    .project { grid-template-columns: 1fr; }
    .project > p:last-child { grid-column: auto; }
  }

  @media print {
    @page { size: A4; margin: 7mm 9mm; }
    :root, body { background: #fff; }
    body { padding: 0; }
    .page-actions { display: none; }
    main { width: auto; max-width: none; padding: 0; border: 0; border-radius: 0; box-shadow: none; }
    .resume-header { align-items: start; gap: 24px; padding-bottom: 9px; }
    .eyebrow { margin-bottom: 5px; font-size: 6.5pt; }
    h1 { font-size: 24pt; }
    .tagline { margin: 5px 0 1px; font-size: 8.5pt; }
    .summary-meta { font-size: 7.6pt; }
    address { align-self: start; gap: 1px; margin: 0; padding: 0; position: relative; top: -2px; font-size: 7.8pt; line-height: 1.18; text-align: left; }
    .contact-row { justify-content: flex-start; flex-wrap: nowrap; white-space: nowrap; }
    section { margin-top: 8px; }
    h2 { gap: 8px; margin-bottom: 3px; font-size: 7.7pt; }
    h3 { font-size: 8.7pt; line-height: 1.23; }
    p, li { font-size: 7.6pt; line-height: 1.24; }
    ul { margin-top: 2px; padding-left: 14px; }
    li { padding-left: 0; }
    li + li { margin-top: 0; }
    .skills { gap: 2px 16px; }
    .skills p { grid-template-columns: 96px 1fr; gap: 5px; }
    .skills strong, .role, .project-tech { font-size: 7.3pt; }
    article + article { margin-top: 5px; }
    .role { margin: 0; }
    .project { column-gap: 10px; }
    .project > p:last-child { margin-top: 1px; }
    a { color: inherit !important; text-decoration: none !important; }
    section, article { break-inside: avoid; }
  }
</style>
